# Copy to .env and fill in. Never commit .env.

# 1 = deterministic stubs, no GPU, no downloads. Tests and CI always use 1.
MOCK_MODELS=1

# Needed for IndicTrans2 (gated: accept the terms on its HF page first).
HF_TOKEN=

LOG_LEVEL=INFO

# 0 disables the tagger's Param-1 tiebreak (ablation 3).
LLM_TIEBREAK=1

# 0 routes by rules alone. Same routes (Param-1's intent is only used when the
# rules agree), one Param-1 call less per request: ~4 s on an Apple M4.
LLM_ROUTER=1

# Param-1 checkpoint for router, tagger tiebreak, rewrite and judge.
LLM_MODEL_ID=bharatgenai/Param-1-2.9B-Instruct

# Sampling seed for Param-1, reset per call so eval runs are reproducible.
LLM_SEED=3235

# IndicTrans2 checkpoint; the distilled ai4bharat/indictrans2-indic-en-dist-200M suits CPU-only machines
TRANSLATE_MODEL_ID=ai4bharat/indictrans2-indic-en-1B

# Comma-separated stages to switch off (transliterate, rerank, rewrite, translate); reported as errors
DISABLE_STAGES=
